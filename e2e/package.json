{
  "name": "focus-flow-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Executable specifications that drive the deployed Focus Flow app through a browser",
  "scripts": {
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "test:unit": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1106.0",
    "@aws-sdk/client-dynamodb": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1106.0",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
